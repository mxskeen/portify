{
  "name": "portify",
  "version": "1.0.0",
  "type": "module",
  "description": "Cross-platform Port & Process Manager with System Tray, Docker & Cloudflare Tunnels",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron . --no-sandbox\"",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron . --no-sandbox",
    "dist": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.maskeen.portify",
    "productName": "Portify",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^33.2.1",
    "electron-builder": "^26.7.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.17",
    "vite": "^6.2.2",
    "wait-on": "^8.0.4"
  }
}
